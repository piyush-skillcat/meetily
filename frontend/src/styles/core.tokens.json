{
  "$description": "SkillCat — CORE tokens (theme-agnostic). DTCG 2025.10. Holds the brand accent, the type/space/radius/motion scales — everything identical in light and dark. Build with a theme file: core + light, or core + dark. Token paths mirror the --sc-* CSS variables (Style Dictionary prefix 'sc' + kebab name → --sc-<path>).",

  "primary":        { "$type": "color", "$value": "#F05523", "$description": "SkillCat orange — the one accent. Same in both themes. 730x in source." },
  "primary-hover":  { "$type": "color", "$value": "#E44515" },
  "primary-shadow": { "$type": "color", "$value": "#8A3114", "$description": "Burnt orange — CTA inner shadow only." },
  "primary-10":     { "$type": "color", "$value": "#F055231A" },
  "primary-20":     { "$type": "color", "$value": "#F0552333" },
  "primary-75":     { "$type": "color", "$value": "#F05523BF" },

  "black":      { "$type": "color", "$value": "#0D0D0D", "$description": "Brand near-black. Reserved; pure #000 only for inner-shadow depth." },
  "white":      { "$type": "color", "$value": "#FCFCFC", "$description": "Body white / text on the orange CTA in both themes." },
  "pure-white": { "$type": "color", "$value": "#FFFFFF" },

  "space": {
    "$type": "dimension",
    "$description": "Grid of 8; all values multiples of 4.",
    "1":  { "$value": { "value": 4,  "unit": "px" } },
    "2":  { "$value": { "value": 8,  "unit": "px" } },
    "3":  { "$value": { "value": 12, "unit": "px" } },
    "4":  { "$value": { "value": 16, "unit": "px" } },
    "5":  { "$value": { "value": 20, "unit": "px" } },
    "6":  { "$value": { "value": 24, "unit": "px" } },
    "8":  { "$value": { "value": 32, "unit": "px" } },
    "10": { "$value": { "value": 40, "unit": "px" } },
    "12": { "$value": { "value": 48, "unit": "px" } },
    "16": { "$value": { "value": 64, "unit": "px" } },
    "20": { "$value": { "value": 80, "unit": "px" } }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Disciplined ladder. 8 buttons/fields/pills, 16 cards, 20 modals.",
    "xs":   { "$value": { "value": 4,   "unit": "px" } },
    "sm":   { "$value": { "value": 8,   "unit": "px" } },
    "md":   { "$value": { "value": 10,  "unit": "px" } },
    "lg":   { "$value": { "value": 16,  "unit": "px" } },
    "xl":   { "$value": { "value": 20,  "unit": "px" } },
    "pill": { "$value": { "value": 999, "unit": "px" } }
  },

  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Fira Sans", "system-ui", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Fira Sans", "system-ui", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["IBM Plex Mono", "ui-monospace", "Menlo", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold":     { "$value": 700 },
      "black":    { "$value": 900 }
    },
    "size": {
      "$type": "dimension",
      "12": { "$value": { "value": 12, "unit": "px" } },
      "13": { "$value": { "value": 13, "unit": "px" } },
      "14": { "$value": { "value": 14, "unit": "px" } },
      "15": { "$value": { "value": 15, "unit": "px" } },
      "16": { "$value": { "value": 16, "unit": "px" } },
      "18": { "$value": { "value": 18, "unit": "px" } },
      "22": { "$value": { "value": 22, "unit": "px" } },
      "24": { "$value": { "value": 24, "unit": "px" } },
      "28": { "$value": { "value": 28, "unit": "px" } },
      "36": { "$value": { "value": 36, "unit": "px" } },
      "40": { "$value": { "value": 40, "unit": "px" } },
      "64": { "$value": { "value": 64, "unit": "px" } }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.0 },
      "snug":  { "$value": 1.15 },
      "body":  { "$value": 1.4 }
    }
  },

  "type": {
    "$type": "typography",
    "$description": "Composite styles. Tracking is documented in DESIGN.md (DTCG dimension can't carry em). h-roles = display, b-roles = mono/body.",
    "h1":      { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.40}", "fontWeight": "{font.weight.bold}",     "lineHeight": "{font.line-height.tight}" } },
    "h2":      { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.24}", "fontWeight": "{font.weight.bold}",     "lineHeight": "{font.line-height.tight}" } },
    "h3":      { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.16}", "fontWeight": "{font.weight.bold}",     "lineHeight": "{font.line-height.tight}" } },
    "h4":      { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.12}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.tight}" } },
    "b1":      { "$value": { "fontFamily": "{font.family.mono}",    "fontSize": "{font.size.14}", "fontWeight": "{font.weight.regular}",  "lineHeight": "{font.line-height.body}" } },
    "b2":      { "$value": { "fontFamily": "{font.family.mono}",    "fontSize": "{font.size.12}", "fontWeight": "{font.weight.medium}",   "lineHeight": "{font.line-height.body}" } },
    "b3":      { "$value": { "fontFamily": "{font.family.body}",    "fontSize": "{font.size.12}", "fontWeight": "{font.weight.regular}",  "lineHeight": "{font.line-height.body}" } },
    "button":  { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.16}", "fontWeight": "{font.weight.bold}",     "lineHeight": "{font.line-height.tight}" } },
    "eyebrow": { "$value": { "fontFamily": "{font.family.display}", "fontSize": "{font.size.12}", "fontWeight": "{font.weight.black}",    "lineHeight": "{font.line-height.tight}" } },
    "label":   { "$value": { "fontFamily": "{font.family.mono}",    "fontSize": "{font.size.14}", "fontWeight": "{font.weight.medium}",   "lineHeight": "{font.line-height.body}" } }
  },

  "ease": {
    "$type": "cubicBezier",
    "out":      { "$value": [0.22, 1, 0.36, 1] },
    "standard": { "$value": [0.4, 0, 0.2, 1] }
  },
  "dur": {
    "$type": "duration",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "base": { "$value": { "value": 200, "unit": "ms" } },
    "slow": { "$value": { "value": 320, "unit": "ms" } }
  }
}
